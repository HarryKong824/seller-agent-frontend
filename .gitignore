# dependencies
/node_modules
/.pnp
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
# 防复发：调试时 rename 出的 .next_* 变体也必须忽略（否则会被 Tailwind v4 源探测扫描，导致 dev 500）
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/
# clerk configuration (can include secrets)
/.clerk/


# cursor 
.cursorrules
/memory-bank

# Sentry Config File
.env.sentry-build-plugin
